server/node_modules/

.env
.env.*
!.env.example

# Firebase Admin SDK service-account key — grants server-side push/admin
# access to the Firebase project. Never commit; each deploy target keeps its
# own local copy at the path FIREBASE_SERVICE_ACCOUNT_PATH points to.
server/config/firebase-service-account*.json

.next/
dist/
build/
out/

*.log
.DS_Store
Thumbs.db

backups/
runtime/
server-data/
server/store.db
server/store.db-shm
server/store.db-wal
server/db.sqlite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
tmp_*
uploads/
/storage/
storage/private/
*.dump
*.backup

server/permanent-storage/**
!server/permanent-storage/
!server/permanent-storage/README.md
!server/permanent-storage/**/
!server/permanent-storage/**/.gitkeep

# Model / Temporary
artifacts/
scratch/
.runlogs/
*.exe
*.apk
*.tgz
*.zip
# Hardware Agent - binary DAU VAO can commit (khong phai build output) de
# CMake copy vao ban cai Windows - xem windows/runner/CMakeLists.txt.
!flutter-apps/dandpak_desktop/windows/hardware-agent/dandpak-agent.exe

# Flutter temp
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/pubspec.lock
build/
**/build/

# Generated product images
web/assets/product-images/*
!web/assets/product-images/.gitkeep

# Generated menu images
server/uploads/menu/*
!server/uploads/menu/.gitkeep



# Dữ liệu nặng của engine — không đưa vào git (đồng bộ riêng, import script)
server/assets/product-images/
server/assets/menu-books/
server/releases/*.apk

# Dữ liệu NGUỒN của script import (export thô từ KiotViet/BCM — không phải asset
# runtime). Data thật đã nằm trong SQLite; giữ trên đĩa để import lại, KHÔNG version.
server/scripts/data/*.md
server/scripts/data/*.xlsx
server/scripts/data/*.csv
server/scripts/*.xlsx
server/scripts/*.csv

# Cấu hình công cụ AI cục bộ của máy dev
.aevum/
.antigravitycli/
.gemini/
.mcp.json

# Bao cao QA sinh tu dong (~87MB) - khong dua vao lich su git
qa-artifacts/

# Rac build cua Gradle va thu muc test tam - khong bao gio commit
.gradle/
.tmp-tests/
