NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

DEPLOYMENT_TARGET=local
DATABASE_PROVIDER=sqlite
SQLITE_PATH=runtime/server-data/store.db
REALTIME_PROVIDER=socketio
STORAGE_PROVIDER=local
STORAGE_PATH=storage

# Temporary demo provider values. Keep service-role keys backend-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Final VPS/PostgreSQL target values.
DATABASE_URL=postgres://dandpak:change-me@postgres:5432/dandpak
POSTGRES_DB=dandpak
POSTGRES_USER=dandpak
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me
SESSION_SECRET=change-me
LOG_LEVEL=info
BACKUP_RETENTION_DAYS=14

# Store Local Edge sync. Leave all values empty until the hardware canary.
# Edge sender: set HUB_ID + HTTPS upstream + the shared secret.
# VPS receiver: set the same secret and an explicit hub-to-branch allowlist.
EDGE_HUB_ID=
EDGE_SYNC_UPSTREAM_URL=
EDGE_SYNC_SHARED_SECRET=
EDGE_SYNC_ALLOWED_HUBS_JSON=

# Haravan connector. Keep token/secret backend-only.
HARAVAN_ENABLED=false
HARAVAN_SHOP_DOMAIN=your-shop.myharavan.com
HARAVAN_ACCESS_TOKEN=
HARAVAN_WEBHOOK_SECRET=
HARAVAN_CLIENT_ID=
HARAVAN_CLIENT_SECRET=
HARAVAN_WEBHOOK_VERIFY_TOKEN=
HARAVAN_SCOPES=openid org profile userinfo grant_service wh_api com.read_orders com.write_orders com.read_products com.write_products com.read_customers com.write_customers com.read_inventories com.write_inventories
HARAVAN_LOCATION_ID=
HARAVAN_API_BASE_URL=https://apis.haravan.com
HARAVAN_DEFAULT_BRANCH_ID=ONLINE

# Firebase Cloud Messaging (push notifications tới thiết bị kể cả khi app đã
# tắt). File service-account tải từ Firebase Console → Project settings →
# Service accounts → Generate new private key — KHÔNG commit, lưu ở đường dẫn
# dưới đây (đã gitignore theo mẫu server/config/firebase-service-account*.json).
FIREBASE_SERVICE_ACCOUNT_PATH=server/config/firebase-service-account.json

# ── Shopee Open Platform (credential CẤP NỀN TẢNG — MỘT bộ cho cả sản phẩm) ──
# Dan D Pak đăng ký app đối tác (ERP/ISV) trên open.shopee.com MỘT LẦN, được
# duyệt go-live, rồi đặt Partner ID/Key ở ĐÂY (server). Người dùng KHÔNG nhập gì
# — chỉ bấm Kết nối → đăng nhập Shopee → đồng ý. Redirect URL khai ở Shopee:
#   https://api.dandpakpos.io.vn/auth/shopee/callback
# Webhook push URL: https://api.dandpakpos.io.vn/webhooks/shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ENV=production

# ── Lazada Open Platform (credential CẤP NỀN TẢNG — như Shopee) ──────────────
# Đăng ký app trên open.lazada.com MỘT LẦN. Redirect:
#   https://api.dandpakpos.io.vn/auth/lazada/callback
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ENV=production
