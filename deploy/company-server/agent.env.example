# ============================================================
# Dan D Pak — Hardware Agent (chạy TẠI MÁY TRONG CỬA HÀNG)
# ------------------------------------------------------------
# BÌNH THƯỜNG KHÔNG CẦN FILE NÀY: app Dan D Pak POS (bản Windows) tự khởi động
# ngầm Hardware Agent khi thu ngân đăng nhập, dùng LUÔN tài khoản/PIN vừa
# đăng nhập — không hiện cửa sổ, không cần cấu hình gì thêm.
#
# File này CHỈ dùng khi cần chạy tay để gỡ lỗi (ví dụ chạy agent trên 1 máy
# khác không phải máy đang mở app POS): copy thành server/.env.agent, sửa giá
# trị bên dưới, rồi chạy:  node server/agent.cjs
# ============================================================

# Địa chỉ server trung tâm (VPS). KHÔNG kèm dấu / ở cuối.
CENTRAL_URL=http://42.96.18.70:3000

# Tài khoản agent đăng nhập (nên dùng tài khoản kho/thu ngân của chi nhánh).
AGENT_USERNAME=warehouse
AGENT_PIN=5555

# Chi nhánh mà máy này phục vụ.
BRANCH_ID=br1

# (Tùy chọn) nhịp hỏi phiếu in & báo máy in — mặc định đủ dùng.
# AGENT_POLL_MS=1500
# AGENT_PRINTERS_MS=20000
# AGENT_MAX_ATTEMPTS=3
# AGENT_COOLDOWN_MS=20000
