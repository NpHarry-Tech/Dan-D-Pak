# ============================================================
# Dan-D Pak POS/ERP — Cấu hình triển khai máy chủ công ty
# ============================================================
# HƯỚNG DẪN:
#   1. Sao chép file này thành .env  (cp .env.example .env)
#   2. Thay thế TẤT CẢ giá trị có chú thích [BẮT BUỘC THAY]
#   3. Không commit file .env lên Git
# ============================================================

# --- Tên miền / địa chỉ IP máy chủ [BẮT BUỘC THAY] ---
# Ví dụ: APP_DOMAIN=192.168.1.100  (IP tĩnh trong mạng LAN)
#        APP_DOMAIN=pos.cty-abc.local  (hostname nội bộ)
APP_DOMAIN=api.dandpakpos.io.vn
APP_URL=https://api.dandpakpos.io.vn
API_BASE_URL=https://api.dandpakpos.io.vn
CORS_ORIGIN=https://dandpakpos.io.vn

# --- Môi trường ---
NODE_ENV=production
PORT=3000
DEPLOYMENT_TARGET=company-server

# --- In ấn ---
# 'auto' (mặc định): server tự in trực tiếp — CHỈ đúng khi server chạy ngay trong
#   mạng LAN cửa hàng, cùng chỗ với máy in/két/máy quẹt thẻ.
# 'agent': BẮT BUỘC dùng khi server đặt trên VPS/datacenter (không chung LAN với
#   cửa hàng) — server chỉ xếp hàng đợi in, một "Hardware Agent" chạy ngay tại
#   máy POS trong cửa hàng sẽ lấy phiếu và in thật + đẩy két (app Dan-D Pak POS
#   bản Windows tự khởi động agent này ngầm khi đăng nhập — không cần cài/chạy
#   gì thêm thủ công). Thiếu dòng này ở server VPS thì "Đồng bộ máy in hệ điều
#   hành" sẽ luôn báo rỗng, vì server cố tự dò máy in Windows trên chính
#   container Linux của nó.
PRINT_DISPATCH=agent

# --- Cơ sở dữ liệu SQLite (chính) ---
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///app/server-data/store.db

# --- Cơ sở dữ liệu PostgreSQL (sidecar — dùng cho backup tự động) ---
POSTGRES_DB=dandpak
POSTGRES_USER=dandpak
# [BẮT BUỘC THAY] Mật khẩu mạnh, không để mặc định
POSTGRES_PASSWORD=Thay_Mat_Khau_Manh_Tai_Day!

# --- Realtime & Storage ---
REALTIME_PROVIDER=socketio
STORAGE_PROVIDER=local
STORAGE_PATH=/app/storage

# --- Haravan (server-only; khong dua token/secret xuong Flutter) ---
HARAVAN_ENABLED=false
HARAVAN_SHOP_DOMAIN=your-shop.myharavan.com
HARAVAN_ACCESS_TOKEN=
HARAVAN_WEBHOOK_SECRET=
HARAVAN_API_BASE_URL=https://apis.haravan.com
HARAVAN_DEFAULT_BRANCH_ID=ONLINE

# --- Bảo mật [BẮT BUỘC THAY] ---
# Tạo bằng lệnh: openssl rand -hex 32
JWT_SECRET=thay-bang-chuoi-ngau-nhien-64-ky-tu-hex
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-64-ky-tu-khac
# AES-256-GCM key. Tao bang: openssl rand -hex 32
DATA_ENCRYPTION_KEY=thay-bang-64-ky-tu-hex-ngau-nhien
DATA_ENCRYPTION_ACTIVE_KEY_ID=production-2026-01
DATA_ENCRYPTION_PEER_KEY_SHA256=REPLACE_WITH_REVIEW_KEY_SHA256
DATA_ENCRYPTION_PREVIOUS_KEYS={}

# --- Ghi log ---
LOG_LEVEL=info
BACKUP_RETENTION_DAYS=30

# --- Seed cấu hình lần đầu (tùy chọn) ---
# Nếu để trống: hệ thống tự tạo dữ liệu demo khi DB còn trống.
# Để bỏ demo seed, bỏ comment dòng dưới:
# DISABLE_DEMO_SEED=true
