# Dan D Pak POS — Shopee Review environment
# Copy -> .env, điền secret tại VPS, KHÔNG commit .env.

API_REVIEW_DOMAIN=api-review.dandpakpos.io.vn
REVIEW_PORTAL_DOMAIN=review.dandpakpos.io.vn
APP_URL=https://api-review.dandpakpos.io.vn
API_BASE_URL=https://api-review.dandpakpos.io.vn
CORS_ORIGIN=https://review.dandpakpos.io.vn

NODE_ENV=production
APP_ENV=review
DEPLOYMENT_TARGET=vps
DISABLE_DEMO_SEED=false
ALLOW_PRODUCTION_DATA=false
PRINT_DISPATCH=agent

DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///app/server-data/review.db

# 32 random bytes, riêng review. Sinh trên VPS: openssl rand -hex 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# Chỉ dùng review account; 8-12 chữ số. Sinh trên VPS, không gửi vào chat/log.
SHOPEE_REVIEWER_PIN=REPLACE_WITH_8_TO_12_DIGIT_PIN

# Shopee Sandbox/Test credentials. Không dùng production key.
SHOPEE_ENV=sandbox
SHOPEE_PARTNER_ID=REPLACE_WITH_SANDBOX_PARTNER_ID
SHOPEE_PARTNER_KEY=REPLACE_WITH_SANDBOX_PARTNER_KEY
# Chỉ set khi Shopee docs/console yêu cầu base khác mặc định:
# SHOPEE_API_BASE_URL=https://...

# Callback:
# https://api-review.dandpakpos.io.vn/auth/shopee/callback
# Webhook:
# https://api-review.dandpakpos.io.vn/webhooks/shopee
