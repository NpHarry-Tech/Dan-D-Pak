# Copy thành .env, chmod/ACL chỉ cho tài khoản vận hành đọc. Không commit .env.
EDGE_BIND_IP=0.0.0.0
EDGE_PORT=3000

DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///app/server-data/store.db
REALTIME_PROVIDER=socketio
STORAGE_PROVIDER=local
STORAGE_PATH=/app/storage
PRINT_DISPATCH=agent
BACKUP_RETENTION_DAYS=30

# ID bất biến của đúng một Edge. Sau khi DB khởi tạo không được đổi.
EDGE_HUB_ID=store-sala-edge-01
EDGE_SYNC_UPSTREAM_URL=https://api.dandpakpos.io.vn
# Cùng secret 32+ ký tự với receiver VPS. Tạo ngẫu nhiên, không dùng mẫu này.
EDGE_SYNC_SHARED_SECRET=THAY_BANG_SECRET_NGAU_NHIEN_TOI_THIEU_32_KY_TU

# Edge là sender, không cấu hình map receiver tại đây.
EDGE_SYNC_ALLOWED_HUBS_JSON=

# AES-256-GCM: openssl rand -hex 32. Không dùng chung với VPS nếu không cần
# giải mã archive/backup của nhau; giữ khóa này trong két secret/backup ngoại vi.
DATA_ENCRYPTION_KEY=THAY_BANG_64_KY_TU_HEX_NGAU_NHIEN
DATA_ENCRYPTION_ACTIVE_KEY_ID=production-2026-01
DATA_ENCRYPTION_PREVIOUS_KEYS={}
SESSION_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_RIENG

# Native Flutter apps không cần CORS. Nếu có dashboard web nội bộ, chỉ liệt kê
# origin cụ thể; không dùng dấu *.
CORS_ORIGIN=
LOG_LEVEL=info
DISABLE_DEMO_SEED=true
DISABLE_WEB_UI=true

# Tích hợp cloud chạy ở VPS, không chạy lặp tại Edge.
HARAVAN_ENABLED=false
