{
    "cmake.ignoreCMakeListsMissing": true,
    "files.watcherExclude": {
        "**/backups/**": true,
        "**/artifacts/**": true,
        "**/qa-artifacts/**": true,
        "**/runtime/**": true,
        "**/out/**": true,
        "**/node_modules/**": true,
        "**/.git/**": true,
        "**/build/**": true,
        "**/.dart_tool/**": true,
        "**/*.db": true
    },
    "search.exclude": {
        "**/backups/**": true,
        "**/artifacts/**": true,
        "**/qa-artifacts/**": true,
        "**/runtime/**": true,
        "**/out/**": true,
        "**/node_modules/**": true,
        "**/build/**": true,
        "**/.dart_tool/**": true,
        "**/*.db": true
    },
    "files.exclude": {
        "**/build": true,
        "**/.dart_tool": true,
        "**/backups": true,
        "**/artifacts": true
    },
    "git.autorefresh": false,
    "git.detectSubmodules": false
}
